            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmpMM:DocumentID>gimp:docid:gimp:680af1a8-3475-4aa6-bde5-eb5ec4cbc31f</xmpMM:DocumentID>
         <xmpMM:InstanceID>xmp.iid:4ec53e08-d7a1-4cf0-8a81-ed4b18b89608</xmpMM:InstanceID>
         <xmpMM:OriginalDocumentID>xmp.did:1b4780a7-fc6d-4dc9-a8d6-27ac4534609a</xmpMM:OriginalDocumentID>
         <xmpMM:History>
