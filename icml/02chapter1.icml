JUFQqksQeTc83vc+29LNEIwmlzXVUKKKCaE0oVy3qfXPTyKQqqDxNOPp0+x5aSQLpZzrVH/UHCxg
mzfquAV5/B4B/Pv2pVVhGCsGCGpWqlqVFD5YI86efSuI0qSc/Z0MnWOacPWyahpIVFUsTcsvoOkX
RiGNzzwP9ifa/bQGlUJKPgqCTTBOKjIPSW+XCKG6/9k=]]></GraphicProxy>
							<GraphicBounds Left="0" Top="0" Right="1728" Bottom="1152" />
						</Properties>
